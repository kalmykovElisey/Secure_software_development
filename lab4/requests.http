### 27. OPERATOR принимает 10 кг и создаёт бонус [201]
POST {{baseUrl}}/api/operations/accept
Authorization: Basic {{l4_operatorEmail}} {{demoPassword}}
X-CSRF-TOKEN: {{l4_csrf}}
Content-Type: application/json

{
  "userId": {{l4_userId}},
  "pointId": {{l4_pointId}},
  "typeId": {{l4_typeId}},
  "weightKg": 10
}

> {%
    const b = response.body;
    if (response.status === 201) { client.global.set("l4_batchAId", String(b.batch.id)); client.global.set("l4_bonusAId", String(b.bonus.id)); client.global.set("l4_today", String(new Date(Date.parse(b.batch.receivedAt) + 3 * 60 * 60 * 1000).toISOString().slice(0,10))); }
    client.test("27. OPERATOR принимает 10 кг и создаёт бонус", function () {
        client.assert(response.status === 201, "Ожидался HTTP 201, получен " + response.status);
        client.assert(b.bonus.points === 30 && b.bonus.status === "PENDING", "10 × 3 = 30");
        client.global.set("l4_passed", String(Number(client.global.get("l4_passed")) + 1));
    });
%}


