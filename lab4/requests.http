### 05. Регистрация обычного пользователя [201]
POST {{baseUrl}}/api/auth/register
X-CSRF-TOKEN: {{l4_csrf}}
Content-Type: application/json

{
  "name": "ЛР4 пользователь",
  "email": "{{l4_email}}",
  "password": "{{demoPassword}}"
}

> {%
    const b = response.body;
    if (response.status === 201) { client.global.set("l4_userId", String(b.userId)); }
    client.test("05. Регистрация обычного пользователя", function () {
        client.assert(response.status === 201, "Ожидался HTTP 201, получен " + response.status);
        client.assert(b.role === "USER" && b.enabled, "Роль регистрации"); client.assert(!("password" in b) && !("passwordHash" in b), "Пароль не возвращается");
        client.global.set("l4_passed", String(Number(client.global.get("l4_passed")) + 1));
    });
%}


