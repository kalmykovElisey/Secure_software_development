# ЛР4. Run All Requests in File; выбрать environment local.
# Сначала заполнить http-client.private.env.json по файлу .example.
# HTTP Client автоматически сохраняет JSESSIONID. Не отключать cookies.
# Создаются только собственные тестовые данные; в конце они удаляются.
# При прерывании полного запуска тестовые записи могут остаться.
# HTTP Basic передаётся в каждом защищённом запросе; сессия хранит только CSRF.
@baseUrl = http://127.0.0.1:8080
@demoPassword = Lab4-Requests!42

### 01. Получить CSRF-токен и cookie [200]
< {%
    const run = String($uuid).toLowerCase();
    client.global.set("l4_email", "lab4-" + run + "@example.com");
    client.global.set("l4_operatorEmail", "lab4-op-" + run + "@example.com");
    ["userId","operatorId","typeId","pointId","batchAId","batchBId","batchCId","bonusAId","bonusBId","bonusCId"].forEach(k => client.global.set("l4_" + k, "0"));
    client.global.set("l4_csrf", "");
    client.global.set("l4_passed", "0");
%}
GET {{baseUrl}}/api/auth/csrf

> {%
    const b = response.body;
    if (response.status === 200) { client.global.set("l4_csrf", String(b.token)); }
    client.test("01. Получить CSRF-токен и cookie", function () {
        client.assert(response.status === 200, "Ожидался HTTP 200, получен " + response.status);
        client.assert(b.headerName === "X-CSRF-TOKEN", "Заголовок CSRF");
        client.global.set("l4_passed", String(Number(client.global.get("l4_passed")) + 1));
    });
%}


### 02. Без Basic Auth вход закрыт [401]
GET {{baseUrl}}/api/auth/me

> {%
    const b = response.body;
    client.test("02. Без Basic Auth вход закрыт", function () {
        client.assert(response.status === 401, "Ожидался HTTP 401, получен " + response.status);
        client.global.set("l4_passed", String(Number(client.global.get("l4_passed")) + 1));
    });
%}


