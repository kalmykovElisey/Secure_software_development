### 25. USER ищет подходящий пункт [200]
GET {{baseUrl}}/api/operations/available-points?typeId={{l4_typeId}}&weightKg=10
Authorization: Basic {{l4_email}} {{demoPassword}}

> {%
    const b = response.body;
    client.test("25. USER ищет подходящий пункт", function () {
        client.assert(response.status === 200, "Ожидался HTTP 200, получен " + response.status);
        client.assert(b.some(p => p.id === Number(client.global.get("l4_pointId")) && p.freeWeightKg === 15 && p.estimatedPoints === 30), "Лимит и оценка бонуса");
        client.global.set("l4_passed", String(Number(client.global.get("l4_passed")) + 1));
    });
%}


