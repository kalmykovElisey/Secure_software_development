### 14. Регистрация выдаёт пару [201]
POST {{baseUrl}}/auth/register
Content-Type: application/json

{"name":"ЛР5 (тест)","email":"lab5-{{runId}}@example.com","password":"{{testPassword}}","deviceId":"registration-{{runId}}"}

> {%
    client.test("Регистрация выдаёт пару", function () {
        client.assert(response.status === 201, "Ожидался 201, получен " + response.status);
        client.assert(typeof response.body.accessToken === "string" && typeof response.body.refreshToken === "string", "Нужны оба токена");
        client.global.set("lab5UserAccess", response.body.accessToken);
        client.global.set("lab5UserRefresh", response.body.refreshToken);
    });
%}

### 15. Самостоятельное повышение роли запрещено [400]
POST {{baseUrl}}/auth/register
Content-Type: application/json

{"name":"ЛР5","email":"inject-{{runId}}@example.com","password":"{{testPassword}}","role":"ADMIN"}

> {%
    client.test("Самостоятельное повышение роли запрещено", function () {
        client.assert(response.status === 400, "Ожидался 400, получен " + response.status);
        client.assert(!response.body.accessToken && !response.body.refreshToken, "Токены в ошибочном ответе");
    });
%}

