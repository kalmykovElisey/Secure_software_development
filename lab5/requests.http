# ЛР5. Выберите local и запустите Run All Requests in File.
# SQL для проверки ACTIVE / USED / REVOKED находится в ЗАПУСК.txt.
@baseUrl = http://127.0.0.1:8080
@testPassword = Lab5-Requests!42

### 01. Вход администратора [200]
< {%
    client.global.set("runId", String($uuid).toLowerCase());
%}
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"{{adminEmail}}","password":"{{adminPassword}}","deviceId":"lab5-{{runId}}"}

> {%
    client.test("Вход администратора", function () {
        client.assert(response.status === 200, "Ожидался 200, получен " + response.status);
        client.assert(typeof response.body.accessToken === "string" && typeof response.body.refreshToken === "string", "Нужны оба токена");
        client.global.set("lab5InitialAccess", response.body.accessToken);
        client.global.set("lab5InitialRefresh", response.body.refreshToken);
    });
%}

### 02. Защищённый API принимает access [200]
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{lab5InitialAccess}}

> {%
    client.test("Защищённый API принимает access", function () {
        client.assert(response.status === 200, "Ожидался 200, получен " + response.status);
        client.assert(response.body.role === "ADMIN", "Ожидалась роль ADMIN");
    });
%}

### 03. Защищённый API требует токен [401]
GET {{baseUrl}}/api/auth/me

> {%
    client.test("Защищённый API требует токен", function () {
        client.assert(response.status === 401, "Ожидался 401, получен " + response.status);
        client.assert(!response.body.accessToken && !response.body.refreshToken, "Токены в ошибочном ответе");
    });
%}

### 04. Refresh нельзя использовать как Bearer [401]
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{lab5InitialRefresh}}

> {%
    client.test("Refresh нельзя использовать как Bearer", function () {
        client.assert(response.status === 401, "Ожидался 401, получен " + response.status);
        client.assert(!response.body.accessToken && !response.body.refreshToken, "Токены в ошибочном ответе");
    });
%}

### 05. Access нельзя использовать для обновления [401]
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{"refreshToken":"{{lab5InitialAccess}}"}

> {%
    client.test("Access нельзя использовать для обновления", function () {
        client.assert(response.status === 401, "Ожидался 401, получен " + response.status);
        client.assert(!response.body.accessToken && !response.body.refreshToken, "Токены в ошибочном ответе");
    });
%}

### 06. Обмен refresh на новую пару [200]
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{"refreshToken":"{{lab5InitialRefresh}}"}

> {%
    client.test("Обмен refresh на новую пару", function () {
        client.assert(response.status === 200, "Ожидался 200, получен " + response.status);
        client.assert(typeof response.body.accessToken === "string" && typeof response.body.refreshToken === "string", "Нужны оба токена");
        client.global.set("lab5CurrentAccess", response.body.accessToken);
        client.global.set("lab5CurrentRefresh", response.body.refreshToken);
        client.assert(response.body.accessToken !== client.global.get("lab5InitialAccess"), "Access должен поменяться");
        client.assert(response.body.refreshToken !== client.global.get("lab5InitialRefresh"), "Refresh должен поменяться");
    });
%}

