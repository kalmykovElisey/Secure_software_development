### 17. Зарегистрированный пользователь имеет роль USER [200]
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{lab5UserAccess}}

> {%
    client.test("Зарегистрированный пользователь имеет роль USER", function () {
        client.assert(response.status === 200, "Ожидался 200, получен " + response.status);
        client.assert(response.body.role === "USER", "Ожидалась роль USER");
        client.global.set("lab5UserId", response.body.userId);
    });
%}

