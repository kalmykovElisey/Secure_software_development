### 23. Операция 2: исправить 10 кг на 12 кг [200]
POST {{lab3_base}}/api/operations/batches/{{lab3_batchAId}}/correct-weight
Content-Type: application/json

{
  "weightKg": 12.0
}

> {%
    const b = response.body;
    client.test("23. Операция 2: исправить 10 кг на 12 кг [200]", function () {
        client.assert(response.status === 200, "Ожидался HTTP 200, получен другой статус");
        client.assert(Number(b.batch.weightKg) === 12, "Вес не исправлен");
        client.assert(Number(b.batch.pointsPerKg) === 3 && Number(b.bonus.points) === 36, "Пересчёт должен использовать сохранённую ставку 3");
        client.assert(b.bonus.status === "PENDING", "Неверный статус пересчитанного бонуса");
        client.assert(b.batch.receivedAt === client.global.get("lab3_receivedAt"), "Корректировка изменила время приёма");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


