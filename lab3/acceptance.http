# ЛР3, вариант 11. Приём вторсырья.
# Запускать весь файл: Run All Requests in File, No Environment.
# Приложение должно работать на 127.0.0.1:8080.
# Файл создаёт собственные данные с уникальным email и удаляет их в конце.
# Ожидаемые 400, 404 и 409 являются успешными отрицательными проверками.
# При прерывании могут остаться тестовые записи с пометкой ЛР3.
# Повторный полный запуск создаёт новый набор; исходные ID не зашиты.

@lab3_base = http://127.0.0.1:8080


### 01. Исходный список: users [200]
< {%
    const keys = ["userId", "typeId", "pointId", "batchAId", "bonusAId", "batchBId", "bonusBId", "batchCId", "bonusCId", "scratchBatchId", "scratchBonusId"];
    keys.forEach(key => client.global.set("lab3_" + key, "0"));
    client.global.set("lab3_today", "1970-01-01");
    client.global.set("lab3_receivedAt", "");
    client.global.set("lab3_passed", "0");
    client.global.set("lab3_run", String($uuid).toLowerCase());
    client.log("Тестовый запуск ЛР3: " + client.global.get("lab3_run"));
%}
GET {{lab3_base}}/api/users

> {%
    const b = response.body;
    if (response.status === 200 && Array.isArray(b)) {
        client.global.set("lab3_baseline_users",
            JSON.stringify(b.map(item => Number(item.id)).sort((a, z) => a - z)));
    }
    client.test("01. Исходный список: users [200]", function () {
        client.assert(response.status === 200, "Ожидался HTTP 200, получен другой статус");
        client.assert(Array.isArray(b), "Ожидался JSON-массив");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


