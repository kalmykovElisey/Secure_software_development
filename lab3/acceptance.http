### 06. CRUD: создать пользователя [201]
POST {{lab3_base}}/api/users
Content-Type: application/json

{
  "name": "ЛР3 {{lab3_run}}",
  "email": "lab3-{{lab3_run}}@example.com"
}

> {%
    const b = response.body;
    if (response.status === 201 && b && (b.email === "lab3-" + client.global.get("lab3_run") + "@example.com") && Number(b.id) > 0
        && !JSON.parse(client.global.get("lab3_baseline_users") || "[]").includes(Number(b.id))) {
        client.global.set("lab3_userId", String(b.id));
    }
    client.test("06. CRUD: создать пользователя [201]", function () {
        client.assert(response.status === 201, "Ожидался HTTP 201, получен другой статус");
        client.assert(Number(b.id) === Number(client.global.get("lab3_userId")) && Number(client.global.get("lab3_userId")) > 0, "ID пользователя не сохранён");
        client.assert(b.email === "lab3-" + client.global.get("lab3_run") + "@example.com", "Email отличается от тестового");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


### 07. CRUD: прочитать пользователя [200]
GET {{lab3_base}}/api/users/{{lab3_userId}}

> {%
    const b = response.body;
