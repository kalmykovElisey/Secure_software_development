### 15. Операция 4: подобрать пункт для 10 кг [200]
GET {{lab3_base}}/api/operations/available-points?typeId={{lab3_typeId}}&weightKg=10.000

> {%
    const b = response.body;
    client.test("15. Операция 4: подобрать пункт для 10 кг [200]", function () {
        client.assert(response.status === 200, "Ожидался HTTP 200, получен другой статус");
        client.assert(Array.isArray(b) && b.length === 1 && Number(b[0].id) === Number(client.global.get("lab3_pointId")), "Не найден единственный подходящий пункт");
        client.assert(Number(b[0].freeWeightKg) === 15 && Number(b[0].estimatedPoints) === 30, "Неверный свободный вес или расчёт бонуса");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


### 16. Операция 1: принять 10 кг и создать бонус [201]
POST {{lab3_base}}/api/operations/accept
Content-Type: application/json

{
  "userId": {{lab3_userId}},
  "pointId": {{lab3_pointId}},
  "typeId": {{lab3_typeId}},
  "weightKg": 10.0
}

> {%
    const b = response.body;
    if (response.status === 201 && b && b.batch && b.bonus
        && Number(b.batch.userId) === Number(client.global.get("lab3_userId")) && Number(client.global.get("lab3_userId")) > 0
        && Number(b.batch.pointId) === Number(client.global.get("lab3_pointId")) && Number(client.global.get("lab3_pointId")) > 0
        && Number(b.batch.typeId) === Number(client.global.get("lab3_typeId"))
        && Number(b.bonus.batchId) === Number(b.batch.id)
        && !JSON.parse(client.global.get("lab3_baseline_recycling-batches") || "[]").includes(Number(b.batch.id))
        && !JSON.parse(client.global.get("lab3_baseline_bonus-entries") || "[]").includes(Number(b.bonus.id))) {
        client.global.set("lab3_batchAId", String(b.batch.id));
        client.global.set("lab3_bonusAId", String(b.bonus.id));
        client.global.set("lab3_receivedAt", b.batch.receivedAt);
        const utc = Date.parse(b.batch.receivedAt.replace(/(\.\d{3})\d+Z$/, "$1Z"));
        client.global.set("lab3_today", new Date(utc + 3 * 60 * 60 * 1000).toISOString().slice(0, 10));
    }
    client.test("16. Операция 1: принять 10 кг и создать бонус [201]", function () {
        client.assert(response.status === 201, "Ожидался HTTP 201, получен другой статус");
        client.assert(Number(b.batch.id) === Number(client.global.get("lab3_batchAId")) && Number(client.global.get("lab3_batchAId")) > 0, "ID партии не сохранён");
        client.assert(Number(b.bonus.id) === Number(client.global.get("lab3_bonusAId")) && Number(client.global.get("lab3_bonusAId")) > 0, "ID бонуса не сохранён");
        client.assert(Number(b.batch.weightKg) === 10 && b.batch.status === "ACCEPTED", "Неверная партия");
        client.assert(Number(b.bonus.points) === 30 && b.bonus.status === "PENDING", "Бонус не создан или неверно рассчитан");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


