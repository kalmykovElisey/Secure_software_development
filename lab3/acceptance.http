### 10. CRUD: создать вид вторсырья [201]
POST {{lab3_base}}/api/recycling-types
Content-Type: application/json

{
  "name": "Тип ЛР3 {{lab3_run}}",
  "unit": "кг",
  "pointsPerKg": 3.0
}

> {%
    const b = response.body;
    if (response.status === 201 && b && (b.name === "Тип ЛР3 " + client.global.get("lab3_run")) && Number(b.id) > 0
        && !JSON.parse(client.global.get("lab3_baseline_recycling-types") || "[]").includes(Number(b.id))) {
        client.global.set("lab3_typeId", String(b.id));
    }
    client.test("10. CRUD: создать вид вторсырья [201]", function () {
        client.assert(response.status === 201, "Ожидался HTTP 201, получен другой статус");
        client.assert(Number(b.id) === Number(client.global.get("lab3_typeId")) && Number(client.global.get("lab3_typeId")) > 0, "ID вида не сохранён");
        client.assert(Number(b.pointsPerKg) === 3, "Неверная ставка");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


