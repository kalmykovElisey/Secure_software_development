### 12. CRUD: создать пункт со связью на вид [201]
POST {{lab3_base}}/api/collection-points
Content-Type: application/json

{
  "address": "Пункт ЛР3 {{lab3_run}}",
  "recyclingTypeIds": [
    {{lab3_typeId}}
  ],
  "available": true,
  "dailyWeightLimit": 15.0
}

> {%
    const b = response.body;
    if (response.status === 201 && b && (b.address === "Пункт ЛР3 " + client.global.get("lab3_run")) && Number(b.id) > 0
        && !JSON.parse(client.global.get("lab3_baseline_collection-points") || "[]").includes(Number(b.id))) {
        client.global.set("lab3_pointId", String(b.id));
    }
    client.test("12. CRUD: создать пункт со связью на вид [201]", function () {
        client.assert(response.status === 201, "Ожидался HTTP 201, получен другой статус");
        client.assert(Number(b.id) === Number(client.global.get("lab3_pointId")) && Number(client.global.get("lab3_pointId")) > 0, "ID пункта не сохранён");
        client.assert(b.recyclingTypeIds.length === 1 && Number(b.recyclingTypeIds[0]) === Number(client.global.get("lab3_typeId")), "Неверная связь пункта и вида");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


