### 21. Убедиться, что отказ не создал партию [200]
GET {{lab3_base}}/api/recycling-batches

> {%
    const b = response.body;
    client.test("21. Убедиться, что отказ не создал партию [200]", function () {
        client.assert(response.status === 200, "Ожидался HTTP 200, получен другой статус");
        client.assert(b.filter(batch => Number(batch.pointId) === Number(client.global.get("lab3_pointId"))).length === 1, "После отказа появилась лишняя партия");
        client.assert(b.some(batch => Number(batch.id) === Number(client.global.get("lab3_batchAId")) && Number(batch.weightKg) === 10), "Исходная партия изменилась");
        client.global.set("lab3_passed", String(Number(client.global.get("lab3_passed") || "0") + 1));
    });
%}


